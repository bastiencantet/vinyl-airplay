{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vinyl AirPlay",
  "version": "0.1.0",
  "identifier": "org.vinylairplay.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vinyl AirPlay",
        "width": 1060,
        "height": 850,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://statici.icloud.com; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Your audio sources, on your AirPlay speakers.",
    "externalBin": [
      "binaries/vinyl-airplay",
      "binaries/vinyl-shazam-fingerprint"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "../tools/shazam-fingerprint/LICENSE": "licenses/fingerprint-LICENSE",
      "../tools/shazam-fingerprint/NOTICE": "licenses/fingerprint-NOTICE"
    }
  }
}
